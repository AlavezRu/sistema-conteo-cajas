# Copia este archivo como .env y cambia los valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# Token que el ESP32 manda con cada caja; debe ser igual al de firmware/config.py
TOKEN_DISPOSITIVO=cambia-este-token
# Clave para reiniciar el conteo (en la iteracion 5 se cambia por inicio de sesion)
CLAVE_ADMIN=cambia-esta-clave
# Llave con la que Flask firma la sesion
SECRET_KEY=cambia-esta-llave

# 1 solo para desarrollar; en el laboratorio siempre 0
FLASK_DEBUG=0
PUERTO=5000
TAMANO_HISTORIAL=20

# Iteracion 4: Google Sheets
RUTA_CREDENCIALES_GOOGLE=credenciales.json
ID_HOJA=
